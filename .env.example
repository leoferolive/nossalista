# docker-compose (Postgres de desenvolvimento)
#
# Copie para `.env` na raiz e ajuste se quiser sobrescrever os defaults de dev.
# O `.env` real e ignorado pelo git (.gitignore) e pelo build (.dockerignore),
# entao nunca sera commitado nem enviado para o contexto de build da imagem.
#
# Se nenhum valor for definido, o `docker-compose.yml` usa os defaults abaixo,
# mantendo `docker compose up` funcionando sem configuracao adicional.

POSTGRES_DB=nossalista_dev
POSTGRES_USER=nossalista
POSTGRES_PASSWORD=nossalista
