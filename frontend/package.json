{
  "name": "nossalista-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build",
    "bundle:check": "node ./scripts/check-bundle-size.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"src/**/*.{css,scss,sass}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "preview:mock": "vite preview --mode mock",
    "preview:smoke": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:pr": "playwright test --grep @pr",
    "test:e2e:fullstack": "E2E_MODE=fullstack playwright test --grep @fullstack",
    "prepare": "cd .. && husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{css,scss}": [
      "stylelint"
    ]
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "axios": "^1.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.3",
    "sockjs-client": "^1.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "stylelint": "^16.24.0",
    "stylelint-config-standard": "^39.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.8",
    "workbox-precaching": "^7.4.0",
    "workbox-window": "^7.4.0"
  },
  "overrides": {
    "@babel/core": "^7.29.6",
    "js-yaml": "^4.2.0"
  }
}
