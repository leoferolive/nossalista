<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
      Removidas em 2026-06-03 (bump de dependências, PR #25):
      - Jackson 3.0.4 / CVE-2026-29062: resolvido pelo upgrade Spring Boot 4.0.3 -> 4.0.6
        (BOM passa a gerenciar tools.jackson.core 3.1.2).
      - DOMPurify / CVE-2025-15599, CVE-2026-0540: resolvido pelo swagger-ui 5.32.0 -> 5.32.6
        (bundle passa a embarcar DOMPurify 3.4.0 >= 3.2.7).
      Não há mais CVE Java sem patch upstream em 2026-06-03; nenhuma supressão nova foi
      necessária para os CVEs do gate (todos cobertos por bump de versão).
    -->
    <suppress>
        <notes><![CDATA[
CVEs in npm transitive dependencies detected via stale backend/package-lock.json.
This file is a residual artifact — the backend is Java/Maven only.
Suppress until the file is removed from the repository.
        ]]></notes>
        <filePath regex="true">.*package-lock\.json.*</filePath>
        <vulnerabilityName regex="true">^(CVE|GHSA)-.*$</vulnerabilityName>
    </suppress>
</suppressions>
