# Google OAuth2 Configuration
# Obtenha as credenciais em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# JWT Configuration
# OBRIGATÓRIO (sem default): a aplicação faz fail-fast na inicialização se o
# secret estiver ausente, for um placeholder de exemplo ou tiver < 32 bytes (HS256).
# Gere um secret aleatório forte, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=__gerar_um_secret_aleatorio_de_pelo_menos_32_bytes__

# Frontend URL (para redirect após OAuth2)
FRONTEND_URL=http://localhost:5173

# NIST NVD API Key (OWASP Dependency Check - aumenta rate limit)
# Obtenha em: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your-nist-nvd-api-key

# Brevo SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
EMAIL_FROM=no-reply@nossalista.leoferolive.com.br
EMAIL_FROM_NAME=NossaLista

# Database Configuration (opcional - já está em application-dev.yml)
# SPRING_DATASOURCE_URL=jdbc:postgresql://192.168.3.63:30001/nossalista_dev
# SPRING_DATASOURCE_USERNAME=nossalista_dev
# SPRING_DATASOURCE_PASSWORD=nossalistadev
