# Google OAuth2 Configuration
# Obtenha as credenciais em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# JWT Configuration
# OBRIGATÓRIO (sem default): a aplicação faz fail-fast na inicialização se o
# secret estiver ausente, for um placeholder de exemplo ou tiver < 32 bytes (HS256).
# Gere um secret aleatório forte, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=__gerar_um_secret_aleatorio_de_pelo_menos_32_bytes__

# Frontend URL (para redirect após OAuth2)
FRONTEND_URL=http://localhost:5173

# NIST NVD API Key (OWASP Dependency Check - aumenta rate limit)
# Obtenha em: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=your-nist-nvd-api-key

# Brevo SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
EMAIL_FROM=no-reply@nossalista.leoferolive.com.br
EMAIL_FROM_NAME=NossaLista

# Verificacao de e-mail (Q2.7)
# Enforcement estrito de verificacao no login email/senha.
# false (default): status registrado, login NAO bloqueado (nao desloga contas
#                  pre-existentes; nao afeta usuarios Google).
# true: login de conta EMAIL nao-verificada retorna 403.
# So ligue apos decidir o tratamento das contas pre-existentes (ver docs/DECISIONS.md).
REQUIRE_EMAIL_VERIFICATION=false

# OAuth do servidor MCP (Fase C — conectores claude.ai/Claude Code, ver docs/mcp.md)
# OBRIGATÓRIA (sem default): mesma validação fail-fast de JWT_SECRET (>= 32 bytes),
# mas com chave PRÓPRIA — NUNCA use o mesmo valor de JWT_SECRET aqui.
#   openssl rand -base64 48
MCP_OAUTH_SIGNING_KEY=__gerar_um_secret_aleatorio_de_pelo_menos_32_bytes__diferente_do_JWT_SECRET__
# Opcionais em dev (default http://localhost:8080[/mcp]); em prod já têm o domínio real
# como default em application-prod.yml.
# MCP_OAUTH_ISSUER=https://nossalista.leoferolive.com.br
# MCP_OAUTH_RESOURCE=https://nossalista.leoferolive.com.br/mcp

# Database Configuration (opcional - já está em application-dev.yml)
# SPRING_DATASOURCE_URL=jdbc:postgresql://192.168.3.63:30001/nossalista_dev
# SPRING_DATASOURCE_USERNAME=nossalista_dev
# SPRING_DATASOURCE_PASSWORD=nossalistadev
